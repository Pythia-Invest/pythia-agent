{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "runtime/managed/runner/**",
      "runtime/test/**",
      "scripts/**",
      "test/**",
      "tooling/**",
      "*.json",
      "*.mts",
      "!!**/dist",
      "!!**/.next",
      "!!**/coverage",
      "!!**/node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {
            "attributes": ["className"],
            "functions": ["cn", "cnState", "cva", "clsx"]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
