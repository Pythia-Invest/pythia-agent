[Unit]
Description=Pythia Agent Desk
After=pythia-agent-hermes.service pythia-agent-basic-memory.service
Wants=pythia-agent-hermes.service pythia-agent-basic-memory.service
PartOf=pythia-agent.target

[Service]
Type=simple
EnvironmentFile=@@DESK_ENVIRONMENT_FILE@@
UnsetEnvironment=API_SERVER_KEY EODHD_API_TOKEN EDGAR_IDENTITY
WorkingDirectory=@@DESK_ROOT@@
ExecStart=@@PYTHON@@ @@SERVICE_LAUNCHER@@ desk @@NODE@@ @@NEXT@@ start --hostname 127.0.0.1 --port 8644
Restart=on-failure
RestartSec=3

[Install]
WantedBy=pythia-agent.target
