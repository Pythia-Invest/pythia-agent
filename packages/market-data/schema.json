{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythia.local/schemas/market-data/v1",
  "$defs": {
    "market_data_type": {
      "enum": [
        "realtime",
        "delayed",
        "frozen",
        "delayed_frozen",
        "eod",
        "unknown"
      ]
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["company", "instrument", "listing", "crypto"]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._:/-]+$",
          "maxLength": 256
        }
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    },
    "provider_ref": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 64
        },
        "native_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "native_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "qualifiers": {
          "$ref": "#/$defs/qualifiers"
        }
      },
      "required": ["provider", "native_id", "native_scope"],
      "additionalProperties": false
    },
    "qualifiers": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "venue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "share_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "network": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "binding": {
      "oneOf": [
        {
          "$ref": "#/$defs/subject"
        },
        {
          "$ref": "#/$defs/provider_ref"
        }
      ]
    },
    "time": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": ["instant"]
            },
            "value": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": ["session_date"]
            },
            "value": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": ["unknown"]
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        }
      ]
    },
    "window": {
      "type": "object",
      "properties": {
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [1]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._:/-]+$",
          "maxLength": 256
        },
        "provider_ref": {
          "$ref": "#/$defs/provider_ref"
        },
        "scope": {
          "enum": ["company", "instrument", "listing", "crypto"]
        },
        "scheme": {
          "enum": [
            "isin",
            "figi",
            "lei",
            "cik",
            "cusip",
            "native",
            "ticker",
            "name",
            "contract_address"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "qualifiers": {
          "$ref": "#/$defs/qualifiers"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "effective": {
          "$ref": "#/$defs/window"
        },
        "authority": {
          "enum": ["source_asserted", "query_only", "unknown"]
        }
      },
      "required": [
        "schema_version",
        "id",
        "provider_ref",
        "scope",
        "scheme",
        "value",
        "qualifiers",
        "adapter_version",
        "observed_at",
        "retrieved_at",
        "effective",
        "authority"
      ],
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [1]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._:/-]+$",
          "maxLength": 256
        },
        "provider_ref": {
          "$ref": "#/$defs/provider_ref"
        },
        "target": {
          "$ref": "#/$defs/subject"
        },
        "status": {
          "enum": ["candidate", "confirmed", "conflicting", "rejected"]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._:/-]+$",
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "rule_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "active_override": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._:/-]+$",
                  "maxLength": 256
                },
                "effect": {
                  "enum": ["positive", "negative"]
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._:/-]+$",
                    "maxLength": 256
                  },
                  "minItems": 1,
                  "maxItems": 10000
                }
              },
              "required": ["id", "effect", "evidence_ids"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "provider_ref",
        "target",
        "status",
        "evidence_ids",
        "rule_version",
        "revision",
        "active_override"
      ],
      "additionalProperties": false
    },
    "unit": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": ["currency"]
            },
            "code": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "scale": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 256
            }
          },
          "required": ["kind", "code", "scale"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": ["shares", "count", "ratio", "percent", "unknown"]
            },
            "scale": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 256
            }
          },
          "required": ["kind", "scale"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": ["asset"]
            },
            "asset": {
              "$ref": "#/$defs/binding"
            },
            "scale": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 256
            }
          },
          "required": ["kind", "asset", "scale"],
          "additionalProperties": false
        }
      ]
    },
    "adjustment": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["none", "split", "split_dividend", "unknown"]
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["kind", "anchor"],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "adjustment": {
          "$ref": "#/$defs/adjustment"
        }
      },
      "required": ["unit", "adjustment"],
      "additionalProperties": false
    },
    "fields": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/field"
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "open": {
              "$ref": "#/$defs/field"
            },
            "high": {
              "$ref": "#/$defs/field"
            },
            "low": {
              "$ref": "#/$defs/field"
            },
            "close": {
              "$ref": "#/$defs/field"
            },
            "volume": {
              "$ref": "#/$defs/field"
            }
          },
          "required": ["open", "high", "low", "close"],
          "additionalProperties": false
        }
      ]
    },
    "methodology": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._:/-]+$",
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": ["id", "version"],
      "additionalProperties": false
    },
    "source_detail": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 64
        },
        "values": {
          "type": "object",
          "maxProperties": 24,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "required": ["namespace", "values"],
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [1]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._:/-]+$",
          "maxLength": 256
        },
        "subject": {
          "$ref": "#/$defs/binding"
        },
        "provider_ref": {
          "$ref": "#/$defs/provider_ref"
        },
        "measurement": {
          "enum": [
            "last_trade",
            "close",
            "bid",
            "ask",
            "midpoint",
            "aggregate_price",
            "ohlc",
            "count",
            "ratio",
            "percent"
          ]
        },
        "shape": {
          "enum": ["scalar", "ohlc"]
        },
        "fields": {
          "$ref": "#/$defs/fields"
        },
        "interval": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": ["tick", "day", "minute", "hour", "unknown"]
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["kind", "count"],
          "additionalProperties": false
        },
        "calendar": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "enum": ["regular", "extended", "all", "unknown"]
        },
        "time_anchor": {
          "enum": [
            "instant",
            "session_date",
            "interval_start",
            "interval_end",
            "unknown"
          ]
        },
        "dataset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "market_data_type": {
          "$ref": "#/$defs/market_data_type"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "methodology": {
          "anyOf": [
            {
              "$ref": "#/$defs/methodology"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/source_detail"
            },
            {
              "type": "null"
            }
          ]
        },
        "read_support": {
          "type": "object",
          "properties": {
            "operations": {
              "type": "array",
              "items": {
                "enum": ["latest", "history"]
              },
              "minItems": 1,
              "maxItems": 10000
            },
            "window_kind": {
              "enum": ["instant", "session_date"]
            },
            "max_span_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "updates": {
              "enum": ["poll", "push"]
            }
          },
          "required": ["operations", "window_kind"],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "id",
        "subject",
        "provider_ref",
        "measurement",
        "shape",
        "fields",
        "interval",
        "calendar",
        "timezone",
        "session",
        "time_anchor",
        "dataset",
        "market_data_type",
        "venue",
        "route",
        "methodology",
        "source_detail"
      ],
      "additionalProperties": false
    },
    "completion": {
      "type": "object",
      "properties": {
        "state": {
          "enum": ["open", "completed", "unknown"]
        },
        "basis": {
          "enum": ["source", "calendar", "unknown"]
        }
      },
      "required": ["state", "basis"],
      "additionalProperties": false
    },
    "observation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "shape": {
              "enum": ["scalar"]
            },
            "time": {
              "$ref": "#/$defs/time"
            },
            "interval": {
              "anyOf": [
                {
                  "$ref": "#/$defs/window"
                },
                {
                  "type": "null"
                }
              ]
            },
            "completion": {
              "$ref": "#/$defs/completion"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 256
            }
          },
          "required": ["shape", "time", "interval", "completion", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "shape": {
              "enum": ["ohlc"]
            },
            "time": {
              "$ref": "#/$defs/time"
            },
            "interval": {
              "anyOf": [
                {
                  "$ref": "#/$defs/window"
                },
                {
                  "type": "null"
                }
              ]
            },
            "completion": {
              "$ref": "#/$defs/completion"
            },
            "open": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 256
            },
            "high": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 256
            },
            "low": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 256
            },
            "close": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 256
            },
            "volume": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 256
            }
          },
          "required": [
            "shape",
            "time",
            "interval",
            "completion",
            "open",
            "high",
            "low",
            "close"
          ],
          "additionalProperties": false
        }
      ]
    },
    "view": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": ["pythia"]
            },
            "subject": {
              "$ref": "#/$defs/binding"
            }
          },
          "required": ["kind", "subject"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": ["source"]
            },
            "series_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._:/-]+$",
              "maxLength": 256
            }
          },
          "required": ["kind", "series_id"],
          "additionalProperties": false
        }
      ]
    },
    "requirements": {
      "type": "object",
      "properties": {
        "freshness": {
          "enum": ["any", "fresh"]
        },
        "completion": {
          "enum": ["any", "completed"]
        },
        "coverage": {
          "enum": ["any", "complete"]
        }
      },
      "required": ["freshness", "completion", "coverage"],
      "additionalProperties": false
    },
    "read_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [1]
        },
        "operation": {
          "enum": ["latest", "history"]
        },
        "view": {
          "$ref": "#/$defs/view"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "view",
        "window",
        "limit",
        "requirements"
      ],
      "additionalProperties": false
    },
    "source_read": {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/$defs/read_request"
        },
        "source_selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": ["request", "source_selector"],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "severity": {
          "enum": ["warning", "error"]
        },
        "source_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "retry_after_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "limit_origin": {
          "enum": ["connector", "provider"]
        }
      },
      "required": ["code", "message", "severity"],
      "additionalProperties": false
    },
    "price_context": {
      "type": "object",
      "properties": {
        "session_window": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "regular": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "end": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            },
            "extended": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "end": {
                  "type": "string",
                  "format": "date-time",
