{
  "contract_version": 1,
  "plugin": "pythia-coinmarketcap",
  "provider": "coinmarketcap",
  "addressing": {
    "native": [
      {
        "native_scope": "coin",
        "level": "security",
        "asset_classes": [
          "crypto"
        ]
      }
    ]
  },
  "concepts": {
    "market_data": {
      "level": "security",
      "via": "security",
      "operations": {
        "quote": "latest",
        "intraday": "history",
        "daily": "history"
      },
      "coverage": {
        "asset_classes": [
          "crypto"
        ]
      }
    }
  },
  "catalogue": {
    "mode": "bulk",
    "operation": "catalogue",
    "scopes": [
      "coins"
    ]
  },
  "rights": {
    "licence": "business",
    "cache": {
      "ttl_seconds": 86400
    },
    "hostable": false,
    "attribution": {
      "text": "Data provided by CoinMarketCap.com",
      "url": "https://coinmarketcap.com"
    }
  },
  "signoff": {
    "status": "grandfathered",
    "record": "docs/sources/coinmarketcap.md"
  },
  "limits": {
    "plan": "Basic",
    "unit": "credit",
    "per_minute": 50,
    "per_month": 15000
  }
}
