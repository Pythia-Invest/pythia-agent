        "level": "security",
        "asset_classes": [
          "crypto"
        ]
      }
    ]
  },
  "concepts": {
    "market_data": {
      "level": "security",
      "via": "security",
      "operations": {
        "quote": "latest",
        "intraday": "history",
        "daily": "history"
      },
