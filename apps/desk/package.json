{
  "name": "@pythia/desk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "check": "next typegen && tsc --noEmit --project tsconfig.json",
    "dev": "next dev --webpack",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:integration": "vitest run test/device-settings.test.ts test/model-initialization.test.ts test/attachments.test.ts",
    "test:unit": "tsc --noEmit --project tsconfig.test.json && vitest run --passWithNoTests --exclude test/device-settings.test.ts --exclude test/model-initialization.test.ts --exclude test/attachments.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@pythia/ui": "workspace:*",
    "ai": "catalog:",
    "@tanstack/react-query": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "streamdown": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
