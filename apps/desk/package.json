{
  "name": "@pythia/desk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/pdf-assets.mjs && next build --webpack",
    "check": "next typegen && tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.test.json",
    "dev": "node scripts/pdf-assets.mjs && next dev --webpack",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:integration": "vitest run test/integration",
    "test:unit": "vitest run --exclude \"test/integration/**\"",
    "test:e2e": "playwright test",
    "test:qualification:widgets": "node qualification/widgets.mjs",
    "test:qualification:data": "node qualification/data.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@pythia/ui": "workspace:*",
    "@pythia/widget-sdk": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "ai": "catalog:",
    "dompurify": "3.4.15",
    "fflate": "0.8.3",
    "lucide-react": "catalog:",
    "mammoth": "1.12.3",
    "next": "catalog:",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.3.289",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "4.4.3",
    "streamdown": "catalog:",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "catalog:",
    "@pythia/market-data": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/papaparse": "5.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "29.1.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
